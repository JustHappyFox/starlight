# Скопируйте в server/.env (или передайте переменными окружения в Docker).
# Полное описание — server/src/config.ts. Обязательные помечены (!).

NODE_ENV=production
PORT=3000
# (!) Публичный HTTPS-адрес мини-аппа — тот же, что указан в BotFather
PUBLIC_URL=https://giveaways.example.com
# Если фронт хостится отдельно (Netlify) — его origin для CORS
# WEBAPP_ORIGIN=https://my-site.netlify.app
DATABASE_PATH=./data/starlight.db
WEBAPP_DIST=../webapp/dist

# --- Telegram ---
# (!) Токен от @BotFather
BOT_TOKEN=
# polling | webhook | off
BOT_MODE=webhook
# Для webhook: любая строка из A-Z a-z 0-9 _ -
WEBHOOK_SECRET=
# Короткое имя мини-аппа из BotFather (/newapp). Пусто — используется Main Mini App бота
MINIAPP_SHORT_NAME=
# Telegram id админов через запятую — уведомления о сбоях, команды /stats /failed /retry /refunds /markpaid /unban
ADMIN_IDS=
# (!) Длинная случайная строка
APP_SECRET=

# --- TON ---
TON_NETWORK=mainnet
TONCENTER_API=https://toncenter.com
# Ключ от @tonapibot — без него лимит 1 запрос/сек
TONCENTER_API_KEY=
# (!) 24 слова сервисного кошелька: принимает оплату и платит Fragment. Отдельный кошелёк только под бота!
TON_WALLET_MNEMONIC=
# v5r1 (W5, как в Tonkeeper сейчас) или v4
TON_WALLET_VERSION=v5r1
# Принимать оплату на другой адрес (по умолчанию — адрес из мнемоники)
# TON_RECEIVE_ADDRESS=
INVOICE_TTL_MIN=20
RATE_BUFFER=0.01

# --- Казначейство: ton (держать TON) | usdt (сразу менять в USDT через STON.fi) ---
TREASURY_MODE=usdt
# true — свопы только логируются. Выключайте после теста на малой сумме
TREASURY_DRY_RUN=true
TREASURY_GAS_RESERVE_TON=1.5
TREASURY_SLIPPAGE=0.01

# --- Выдача призов: mock | fragment ---
FULFILLMENT_PROVIDER=fragment
# Cookie строки с fragment.com после входа ТЕМ ЖЕ кошельком (stel_ssid=...; stel_token=...; stel_ton_token=...)
FRAGMENT_COOKIES=
# true — переводы Fragment не отправляются, только логируются
FULFILLMENT_DRY_RUN=true
CLAIM_WINDOW_DAYS=7

# --- Цены, USD (проверьте актуальные!) ---
TG_STAR_PRICE_USD=0.0199
TG_PREMIUM_PRICES_USD=13.99,18.99,34.99
FRAGMENT_STAR_PRICE_USD=0.015
FRAGMENT_PREMIUM_PRICES_USD=11.99,15.99,28.99

# --- Лимиты и защита ---
MIN_STARS=50
MAX_WINNERS=200
MAX_DURATION_DAYS=60
REF_TICKET_CAP=100
CAPTCHA_MIN_SOLVE_MS=1500
HONEYPOT_GLOBAL_BAN_HITS=3
BUTTON_UPDATE_INTERVAL_SEC=60
# off | log | enforce — страна по IP (только за Cloudflare)
GEO_IP_MODE=off
